# Copy to .env and adjust. Every variable is optional.

# Your timezone, so measurement times are right.
TZ=UTC

# Only accept this scale (find it at /api/debug/devices). Empty accepts any Mi Body Composition Scale 2 nearby.
MISCALE_SCALE_MAC=

# Language of the notification text: en or pt-BR. The web UI follows the browser and can be changed in Settings.
MISCALE_LANG=en

# Link added to notifications (how you reach the dashboard).
MISCALE_PUBLIC_URL=

# Notifications for every weigh-in (optional). A generic JSON webhook...
MISCALE_WEBHOOK_URL=
# ...and/or Telegram with your own bot (@BotFather) and chat id.
MISCALE_TELEGRAM_TOKEN=
MISCALE_TELEGRAM_CHAT_ID=

# Weekly analysis written by an AI model (optional). Leave the key empty to turn it off.
# Any OpenAI-compatible API works: OpenAI, OpenRouter, a local Ollama or LM Studio.
# Only the weekly numbers are sent to the provider; use a local Ollama to keep everything at home.
MISCALE_AI_API_KEY=
# https://api.openai.com/v1 (default), https://openrouter.ai/api/v1, http://<host>:11434/v1 (Ollama)...
MISCALE_AI_BASE_URL=
# One model, or a comma-separated list tried in order. Default gpt-5.4-mini.
MISCALE_AI_MODEL=
# A local server with no key (Ollama): set this to true instead of a key.
MISCALE_AI_ENABLED=
# When the weekly analysis runs: weekday (0 = Monday ... 6 = Sunday, or a name) and hour. Default Saturday 9:00.
MISCALE_AI_WEEKDAY=5
MISCALE_AI_HOUR=9
# Language of the analysis: en or pt-BR. Empty follows MISCALE_LANG.
MISCALE_AI_LANG=
