# Copy to .env and adjust. Every variable is optional.

# Your timezone, so measurement times are right.
TZ=UTC

# Only accept this scale (find it at /api/debug/devices). Empty accepts any Mi Body Composition Scale 2 nearby.
MISCALE_SCALE_MAC=

# Language of the notification text: en or pt-BR. The web UI follows the browser and can be changed in Settings.
MISCALE_LANG=en

# Link added to notifications (how you reach the dashboard).
MISCALE_PUBLIC_URL=

# Notifications for every weigh-in (optional). A generic JSON webhook...
MISCALE_WEBHOOK_URL=
# ...and/or Telegram with your own bot (@BotFather) and chat id.
MISCALE_TELEGRAM_TOKEN=
MISCALE_TELEGRAM_CHAT_ID=
